#. [lua]
#: A_Song_of_the_Winds/utils/dehydration-utils.cfg:222
msgid ""
"dehydrated: This unit is dehydrated. It will lose 4 HP and have its damage reduced by 1 each turn during the day unless prevented by healers or cured by water at an oasis.\n"
"\n"
"Units cannot be killed or deal no damage as a result of dehydration."
msgstr ""
"deshidratado: Esta unidad está deshidratada. Perderá 4 PV y su daño se reducirá en 1 cada turno durante el día a menos que sea prevenido por sanadores o curado con agua en un oasis.\n"
"\n"
"Las unidades no pueden morir ni dejar de infligir daño como resultado de la deshidratación."

#. [message], speaker=Maat
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:15
msgid "Is this how my history ends...?"
msgstr "¿Así termina mi historia…?"

#. [message], speaker=Hathor
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:38
msgid "DENI!!!"
msgstr "¡¡¡DENI!!!"

#. [message], speaker=Abhai
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:54
msgid "Not... yet...!"
msgstr "¡Aún… no…!"

#. [message], speaker=Hathor
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:68
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:225
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:416
msgid "I cannot fall now...!"
msgstr "¡No puedo caer ahora…!"

#. [message], speaker=Maat
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:72
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:104
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:229
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:295
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:476
msgid "SISTA, NO!!!"
msgstr "¡¡¡HERMANA, NO!!!"

#. [message], speaker=Raika
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:86
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:243
msgid "I am Raika, and Ascendant of Hiera'Shirsha, I must <i>not</i> fall...!"
msgstr "Soy Raika, y Ascendida de Hiera'Shirsha, ¡<i>no</i> debo caer…!"

#. [message], speaker=Urania
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:137
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:328
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:509
msgid ""
"I fall far from home... Please, Maat, if I ever served you loyally, bring my"
" song back to Esthiel so my people will know who I was..."
msgstr ""
"Caigo lejos de casa… Por favor, Maat, si alguna vez te serví con lealtad, "
"lleva mi canción de vuelta a Esthiel para que mi pueblo sepa quién fui…"

#. [message], speaker=Maat
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:141
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:332
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:513
msgid ""
"You were a valiant fighter and a good companion, Uránia. I'm sorry I "
"couldn't bring you back to your home, but rest assured that your song shall "
"echo in your forests - and in our scrolls."
msgstr ""
"Fuiste una luchadora valiente y una buena compañera, Urania. Lamento no "
"haber podido llevarte de vuelta a casa, pero ten por seguro que tu canción "
"resonará en tus bosques… y en nuestros pergaminos."

#. [message], speaker=Celebriniel
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:153
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:344
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:525
msgid ""
"To the earth I return... Please, Maat, if I ever served you well, bring my "
"song back to Esthiel so the druids may sing it to our trees..."
msgstr ""
"A la tierra regreso… Por favor, Maat, si alguna vez te serví bien, lleva mi "
"canción de vuelta a Esthiel para que los druidas la canten a nuestros "
"árboles…"

#. [message], speaker=Maat
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:157
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:348
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:529
msgid ""
"You were a brave fighter and a kind companion, Celebriniel. I'm sorry I "
"couldn't bring you back to your home, but rest assured that your song shall "
"echo in your forests - and in our scrolls."
msgstr ""
"Fuiste una luchadora valiente y una compañera amable, Celebriniel. Lamento "
"no haber podido llevarte de vuelta a casa, pero ten por seguro que tu "
"canción resonará en tus bosques… y en nuestros pergaminos."

#. [message], speaker=Maat
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:171
msgid "I... can't... fall...!"
msgstr "¡No… puedo… caer…!"

#. [message], speaker=Deianira
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:189
msgid "Hathy...!"
msgstr "¡Hathy…!"

#. [message], speaker=Abhai
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:207
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:398
msgid "Is this how I fall...?"
msgstr "¿Así es como caigo…?"

#. [message], speaker=Maat
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:211
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:402
msgid "ABHAI!!!"
msgstr "¡¡¡ABHAI!!!"

#. [message], speaker=Lamiya
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:258
msgid "D-dad...!"
msgstr "¡P-papá…!"

#. [message], speaker=Deianira
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:262
msgid "LAMI! How could we let her die?!"
msgstr "¡LAMI! ¿¡Cómo pudimos dejarla morir!?"

#. [message], speaker=Sunna
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:276
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:453
msgid "And thus the sun sets for me..."
msgstr "Y así se pone el sol para mí…"

#. [message], speaker=Sekmet
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:291
msgid "<i>How... pathetic...!</i>"
msgstr "<i>¡Qué… patético…!</i>"

#. [message], speaker=Maat
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:420
msgid "SIS, NO!!!"
msgstr "¡¡¡HERMANA, NO!!!"

#. [message], speaker=Raika
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:434
msgid "Sisters... fight on...!"
msgstr "Hermanas… ¡sigan luchando…!"

#. [message], speaker=Deianira
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:438
msgid "Raika, please don't fall!"
msgstr "¡Raika, por favor no caigas!"

#. [message], speaker=Abhai
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:457
msgid "No! How could we let her die like this?"
msgstr "¡No! ¿Cómo pudimos dejarla morir así?"

#. [message], speaker=Sekmet
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:472
msgid "<i>Can't... fall... yet...!</i>"
msgstr "<i>¡Aún… no… puedo… caer…!</i>"

#. [message], speaker=Isilieth
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:541
msgid ""
"Thus my song ends... I only hope I managed to redeem myself, if only a "
"little..."
msgstr ""
"Así termina mi canción… Solo espero haber logrado redimirme, aunque sea un "
"poco…"

#. [message], speaker=Sunna
#: A_Song_of_the_Winds/utils/heroes-last-breath.cfg:545
msgid ""
"You were but the victim of fate, poor Isilieth, and paid the price for "
"crimes committed before you came to this world. Rest in the arms of the "
"First, my child..."
msgstr ""
"Fuiste solo víctima del destino, pobre Isilieth, y pagaste el precio por "
"crímenes cometidos antes de llegar a este mundo. Descansa en los brazos de "
"la Primera, mi niña…"

#. [message], speaker=narrator
