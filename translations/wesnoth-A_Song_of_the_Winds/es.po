#. [female]
#: A_Song_of_the_Winds/units/heroes/Herald.cfg:5
#: A_Song_of_the_Winds/units/heroes/Maat_Herald.cfg:5
#: A_Song_of_the_Winds/units/heroes/Raika_Herald.cfg:5
#: A_Song_of_the_Winds/units/timestrays/d3_Herald.cfg:116
