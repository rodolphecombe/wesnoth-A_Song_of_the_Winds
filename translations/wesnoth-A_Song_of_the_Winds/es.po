#: A_Song_of_the_Winds/units/heroes/Ascendant_Projection.cfg:38
#: A_Song_of_the_Winds/units/heroes/Dark_Ascendant.cfg:35
#: A_Song_of_the_Winds/units/heroes/Raika_Ascendant.cfg:57
msgid "touch"
msgstr "toque"

