#: A_Song_of_the_Winds/units/heroes/Worldsweave_Herald.cfg:53
msgid "Staff of Amunet-Isis"
msgstr "Bastón de Amunet-Isis"

#. [attack], type=fire, range=ranged
#: A_Song_of_the_Winds/units/heroes/High_Ascendant.cfg:81
msgid "Yansa's Touch"
msgstr "Toque de Yansa"

#. [attack], type=arcane, range=ranged
