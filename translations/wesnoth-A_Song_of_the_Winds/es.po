msgid ""
"$unit.name| has found a Staff of Sekhem, which allows those of the Seeker "
"line as well as magic-wielding units to cast powerful fire, cold and arcane "
"attacks!"
msgstr ""
"$unit.name| ha encontrado un Bastón de Sekhem, que permite a quienes "
"pertenecen a la línea de Buscador, así como a unidades que manejan magia, "
"lanzar poderosos ataques de fuego, frío y arcano!"

#. [object], id=staff_sekhem
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:551
msgid "Staff of Sekhem"
msgstr "Bastón de Sekhem"

#. [object], id=staff_sekhem
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:554
msgid ""
"$unit.name| now wields a Staff of Sekhem, harnessing its power to cast "
"magical arcane, fire and cold attacks!"
msgstr ""
"¡$unit.name| ahora empuña un Bastón de Sekhem, canalizando su poder para "
"lanzar ataques mágicos arcanos, de fuego y frío!"

#. [object], id=staff_sekhem
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:555
msgid ""
"Only Seekers, Elvish Shamans and their respective advancements may wield the"
" Staff of Sekhem!"
msgstr ""
"¡Solo Buscadores, Chamanes Élficos y sus respectivos avances pueden empuñar "
"el Bastón de Sekhem!"

#. [effect]
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:569
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:582
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:595
msgid "staff of Sekhem"
msgstr "bastón de Sekhem"

#. [message], speaker=narrator
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:645
msgid ""
"$unit.name| has found a Shard of the Raw, which those of the Courier line "
"may wield to perform powerful attacks of the cold, fire and arcane types!"
msgstr ""
"$unit.name| ha encontrado un Fragmento del Crudo, que quienes pertenecen a "
"la línea de Mensajero pueden empuñar para realizar poderosos ataques de "
"frío, fuego y arcano!"

#. [object], id=shard_raw
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:651
msgid "Shard of the Raw"
msgstr "Fragmento del Crudo"

#. [object], id=shard_raw
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:654
msgid ""
"$unit.name| now controls a Shard of the Raw, allowing her to cast powerful "
"arcane, fire and cold attacks!"
msgstr ""
"¡$unit.name| ahora controla un Fragmento del Crudo, permitiéndole lanzar "
"poderosos ataques arcanos, de fuego y frío!"

#. [object], id=shard_raw
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:655
msgid ""
"Only Couriers, Reavers, Emissaries and Dreadnoughts may wield the Shard of "
"the Raw!"
msgstr ""
"¡Solo Mensajeros, Saqueadores, Emisarios y Acorazados pueden empuñar el "
"Fragmento del Crudo!"

#. [effect]
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:669
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:682
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:695
msgid "shard of the Raw"
msgstr "fragmento del Crudo"

#. [message], speaker=narrator
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:745
msgid ""
"$unit.name| has found an Amulet of Sobek, which allows its wearer to both "
"move and defend better while on water!"
msgstr ""
"$unit.name| ha encontrado un Amuleto de Sobek, que permite a quien lo lleva "
"moverse y defenderse mejor mientras está en agua!"

#. [object], id=sobek_amulet
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:751
msgid "Amulet of Sobek"
msgstr "Amuleto de Sobek"

#. [object], id=sobek_amulet
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:754
msgid ""
"$unit.name| now wears an Amulet of Sobek, which increases their defences on "
"watery terrain and makes its crossing much easier!"
msgstr ""
"¡$unit.name| ahora porta un Amuleto de Sobek, que aumenta sus defensas en "
"terreno acuático y hace mucho más fácil cruzarlo!"

#. [message], speaker=narrator
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:820
msgid "$unit.name| has found an enchanted Scorpion Mace!"
msgstr "$unit.name| ha encontrado una Maza de Escorpión encantada!"

#. [object], id=scorpion_mace
#: A_Song_of_the_Winds/utils/hierasaret-items.cfg:826
